# kutsh-crm — variables d'environnement (copier en .env, gitignoré)
#   cp .env.example .env  &&  éditer

# --- Twenty (CRM, source de vérité) ---
TWENTY_API_KEY=
TWENTY_BASE_URL=https://twenty.kutsh.fr

# --- Brevo (emailing) ---
BREVO_API_KEY=
# Expéditeur des campagnes (doit être un expéditeur VÉRIFIÉ dans Brevo).
# Si vide, le script prend le 1er expéditeur vérifié du compte.
BREVO_SENDER_EMAIL=felix@kutsh.fr
BREVO_SENDER_NAME=Félix & Joël · Kutsh
# Dossier Brevo qui regroupe les 3 listes (créé s'il n'existe pas).
BREVO_FOLDER=Kutsh CRM

# --- Divers ---
LAZONE_URL=https://lazone.kutsh.fr
